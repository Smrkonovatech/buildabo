# ----------------------------------------------------------------------
# 1. CLEAN URLS & REWRITES
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Explicit route for /blog and /blog/ -> blog.html
    RewriteRule ^blog/?$ blog.html [L,QSA]
    RewriteRule ^blog/house-design-and-drawings-in-bangalore/?$ house-design-and-drawings-in-bangalore.html [L,QSA]

    # Clean URLs for all pages: serve .html if file without extension requested
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# ----------------------------------------------------------------------
# 2. COMPRESSION (mod_deflate)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------
# 3. CACHE-CONTROL & EXPIRES
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Images (1 year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts (1 year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # CSS & JavaScript (1 year - versioned via query params)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # HTML (always revalidate so fresh deployments are immediately seen)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # 1 year cache for versioned static assets
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML must always revalidate so fresh deployments appear immediately
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
